# S-AI SoulBot — environment configuration
#
# Copy to `.env.local` for local development, or set these in the Vercel
# project settings. Every one of them is optional; the defaults are deliberately
# conservative, so a deployment with nothing configured refuses more than it
# permits.
#
# No secret belongs in this file. The Sentinel holds no secret on the server
# side at all — see `api/_lib/config.ts`.

# --- Identity ----------------------------------------------------------------

# Reported in /api/health and the console header.
SOULBOT_VERSION=3.0.0

# --- Conservative defaults ---------------------------------------------------

# Per-flow ceilings applied when a flow does not declare its own.
SOULBOT_DEFAULT_MAX_TOKENS=500000
SOULBOT_DEFAULT_MAX_COST_USD=0.50

# Fixed-window rate limit, per client, per instance.
SOULBOT_RATE_LIMIT_REQUESTS=120
SOULBOT_RATE_LIMIT_WINDOW_MS=60000

# Tiers that can run in this runtime. T0/T1 need the build pipeline and are
# always reported as skipped in-process.
SOULBOT_CONFORMANCE_TIERS=T2,T3,T4,T5,T6

# --- Optional durable store --------------------------------------------------

# Any Redis-compatible REST store: Vercel KV, Upstash, Memorystore.
# Without these, traces and consent state live in process memory and are lost
# when the runtime recycles. The ActionTrace hash chain still detects tampering
# with whatever is retained; it just cannot retain much.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# --- Optional signing key ----------------------------------------------------

# For deployments that sign their own decisions.
# SENTINEL_SIGNING_KEY=

# --- MCP HTTP transport ------------------------------------------------------

# Bearer token for POST /api/mcp. Unset means the endpoint is open (rate-limited
# and Origin-checked, but unauthenticated). Every MCP tool is read-only over
# committed data, so the default is a considered choice — a mandatory secret
# makes the endpoint un-introspectable by the registry clients it serves. Set
# this on any deployment that is not deliberately public.
# SOULBOT_MCP_TOKEN=

# Extra origins allowed to call /api/mcp, comma-separated. Same-origin requests
# always pass; this is only for a console served from a different host.
# SOULBOT_MCP_ALLOWED_ORIGINS=

# --- Set automatically by Vercel ---------------------------------------------

# VERCEL_ENV=development | preview | production
# VERCEL_URL=s-ai-soulbot.vercel.app

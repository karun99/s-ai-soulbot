{
  "name": "s-ai-soulbot",
  "version": "3.0.0",
  "private": false,
  "description": "S-AI SoulBot \u2014 a consent-gated companion harness. Trust and resilience core with a J\u0101taka case-law guardrail registry, Sentinel authorization authority, and an authorized-session browser node.",
  "license": "MIT",
  "author": "Sai Karun Nandipati",
  "keywords": [
    "mcp",
    "mcp-server",
    "soulbot",
    "s-ai",
    "browser-automation",
    "consent",
    "guardrails",
    "jataka",
    "sentinel",
    "trust",
    "llm",
    "agent"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "conformance": "tsx scripts/conformance.ts",
    "mcp:stdio": "tsx mcp/stdio.ts",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build",
    "dev:vercel": "vercel dev",
    "deploy": "vercel --prod"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.5",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^4.3.4",
    "@vercel/node": "^3.2.29",
    "@vitest/coverage-v8": "^2.1.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.7",
    "vitest": "^2.1.8"
  }
}
